{
  "name": "permuta-academica",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev -w api\" \"npm run dev -w web\"",
    "db:reset": "npm run db:reset -w api",
    "test": "npm test -w api",
    "build": "npm run build -w web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
